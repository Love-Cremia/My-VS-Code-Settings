# =========================
# デフォルトの改行コード設定
# =========================
# すべてのテキストファイルを、OSを問わず手元でもGit内部でも LF に統一
* text eol=lf


# =========================
# Windows 専用スクリプト (改行コードを CRLF に固定)
# =========================
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
*.psm1          text eol=crlf
*.psd1          text eol=crlf
*.reg           text eol=crlf


# =========================
# シェルスクリプト等 (改行コードを LF に固定)
# =========================
# Windows環境でチェックアウトしてもLFを維持 (CRLFになると実行エラーになるため)
*.sh            text eol=lf
*.bash          text eol=lf
*.zsh           text eol=lf


