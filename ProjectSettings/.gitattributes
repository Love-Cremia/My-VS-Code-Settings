# =========================
# デフォルトの改行コード設定
# =========================
# すべてのテキストファイルを、OSを問わず手元でもGit内部でも LF に統一
* text eol=lf


# =========================
# Windows 専用スクリプト (改行コードを CRLF に固定)
# =========================
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
*.psm1          text eol=crlf
*.psd1          text eol=crlf
*.reg           text eol=crlf


# =========================
# シェルスクリプト等 (改行コードを LF に固定)
# =========================
# Windows環境でチェックアウトしてもLFを維持 (CRLFになると実行エラーになるため)
*.sh            text eol=lf
*.bash          text eol=lf
*.zsh           text eol=lf


# =========================
# 画像・メディアファイル (バイナリ指定)
# =========================
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.svg           text
*.bmp           binary
*.tiff          binary
*.psd           binary
*.ai            binary


# =========================
# 圧縮・アーカイブファイル (バイナリ指定)
# =========================
*.zip           binary
*.tar           binary
*.gz            binary
*.7z            binary
*.rar           binary


# =========================
# Office & Power BI ファイル (バイナリ指定)
# =========================
# Excel
*.xlsx          binary
*.xlsm          binary
*.xls           binary
*.xltx          binary
*.xltm          binary

# Word
*.docx          binary
*.doc           binary
*.dotx          binary

# PowerPoint
*.pptx          binary
*.ppt           binary
*.potx          binary

# Power BI
*.pbix          binary
*.pbit          binary

# =========================
# VBA Form Binary
# =========================
# フォーム用バイナリ（改行コード変換の完全抑止・差分計算の抑止）
*.frx           binary

# =========================
# VBE Exported Text Files (CP932 / CRLF)
# =========================
# VBEから標準エクスポートされるファイル群
# - working-tree-encoding: リポジトリ内はUTF-8で保持し，作業ツリー展開時にCP932へ復元（またはCP932のまま正しく差分比較）
# - eol=crlf: Windows VBEが要求するCRLFを維持
*.frm           text working-tree-encoding=cp932 eol=crlf
*.bas           text working-tree-encoding=cp932 eol=crlf
*.cls           text working-tree-encoding=cp932 eol=crlf
