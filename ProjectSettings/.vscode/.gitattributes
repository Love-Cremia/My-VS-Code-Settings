# 1. デフォルト設定 (テキストファイルは Git が自動判別し、リポジトリ内は LF、チェックアウト時は OS に合わせる)
* text=auto

# 2. Windows 実行スクリプト (明示的に常に CRLF でチェックアウト)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

