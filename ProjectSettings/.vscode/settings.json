{
    // Markdown 標準プレビューでナンバリング
    "markdown.styles": [
        "./.vscode/markdown-preview-numbering.css"
    ],

    // textlint の設定
    "textlint.run": "onType",
    "textlint.autoFixOnSave": true,
    "textlint.languages": [
        "markdown"
    ],

    "[markdown]": {
        // markdownlint による構造チェック・フォーマットを有効化
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
        "editor.formatOnSave": true
    }
}
