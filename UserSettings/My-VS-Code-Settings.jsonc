{
    "workbench.editor.enablePreview": false,
    "workbench.preferredLightColorTheme": "Dark 2026",
    "chat.viewSessions.orientation": "stacked",
    "editor.minimap.enabled": false,
    "update.showReleaseNotes": false,
    "editor.hover.enabled": "onKeyboardModifier",

    // 保存時に最終行を自動で追加する
    "files.insertFinalNewline": true,
    // 保存時に余計な末尾改行を除去する
    "files.trimFinalNewlines": true,
    // 行末のスペースやスペースだけの行があるとき，余計なスペースをトリムする
    "files.trimTrailingWhitespace": true,


    // Markdownファイル向けの設定
    "[markdown]": {
        // 行末スペース（改行）を勝手に消されないよう保護
        "files.trimTrailingWhitespace": false,

        // インデント幅を 4 スペースに固定
        "editor.tabSize": 4,

        // 保存時フォーマット（テーブル整形等）は Markdown All in One に任せる
        "editor.defaultFormatter": "yzhang.markdown-all-in-one",
        "editor.formatOnSave": true,

        // markdownlint の強固な自動修正は codeActionsOnSave で保存時に強制実行する
        "editor.codeActionsOnSave": {
            "source.fixAll.markdownlint": "explicit"
        },
        // Markdown エディターだけ等幅フォントを使用する
        // → テーブルをフォーマットしたとき罫線の位置が揃って見える
        // ただし ASCII Tree 図の記号はズレて表示される
        // ※ プレビューのコードブロックは全体の "editor.fontFamily" を参照するため，
        // Markdown 限定にしないと，プレビューにおける ASCII Tree 図の罫線が半角として扱われず見にくくなる
        "editor.fontFamily": "'BIZ UDGothic', 'ＭＳ ゴシック', 'SF Mono', Menlo, Monaco, 'Osaka-等幅', monospace"
    },

    // Markdown プレビューのフォントは欧文フォントを優先して使用．
    // → ASCII Tree 図の罫線が半角として扱われて見やすくなる
    "markdown.preview.fontFamily": "'SF Mono', Consolas, Menlo, Monaco, 'Courier New', monospace",


    // Markdown All in One のテーブルフォーマットを有効化
    "markdown.extension.tableFormatter.enabled": true,


    // markdownlint のユーザ設定
    // MacとWindowsで共通のパスを指定できるようにするため，ホームディレクトリに VS-Code フォルダを作る
    // 今後ほかにもワークスペースではなくユーザレベルで設定するものがあればこの VS-Code フォルダにまとめる
    "markdownlint.configFile": "~/VS-Code/.markdownlint.jsonc",

    // textlint の設定
    "textlint.run": "onType",
    "textlint.autoFixOnSave": true,
    "textlint.languages": [
        "markdown"
    ],


    // JSONの整形設定
    "[json]": {
        "editor.tabSize": 4,
        "editor.formatOnSave": true
    },
    "[jsonc]": {
        "editor.tabSize": 4,
        "editor.formatOnSave": true
    },
    // JSON ファイルの整形時に、空行があっても保持する
    "json.format.keepLines": true,


    // 空白文字の表示設定
    // boundary は単語の境界にある空白以外を表示する
    // インデントのスペースも写っちゃうから気が散るかも？　適宜変更
    "editor.renderWhitespace": "boundary",


    // 全角スペースや特殊な空白文字を強調表示する
    "editor.unicodeHighlight.invisibleCharacters": true,

    // 紛らわしい全角記号 (全角カンマや全角セミコロン等) を強調表示する
    "editor.unicodeHighlight.ambiguousCharacters": true,

    // 日本語の文字列（"..."の中身）までハイライトされないようにする
    "editor.unicodeHighlight.includeStrings": false,

    // 日本語テキスト全体がハイライトされるのを防ぐ
    "editor.unicodeHighlight.nonBasicASCII": false,

    // インデントの自動検出を無効化する
    // これにより既存JSONファイルでも，本ファイルで指定しているように規定インデントを4個スペースにできる
    "editor.detectIndentation": false,

    // エクスプローラーツリーから消すもの（完全なゴミ・内部キャッシュ）
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true
    },

    // ツリーには出すが、全体検索（Ctrl+Shift+F）の結果から除外するもの
    "search.exclude": {
        "**/.venv": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true
    },

    // ファイル監視の対象から外して VS Code を軽量化するもの
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/node_modules/**": true
    },

    // 1. Python ファイルに対するフォーマッターとして Ruff を指定
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            // 保存時に未使用 import の削除やリントエラーの自動修正を実行
            "source.fixAll": "explicit",
            // 保存時に import 文の自動並び替えを実行 (isort 相当)
            "source.organizeImports": "explicit"
        }
    },

    // 2. Pylance の型チェック設定
    // "off", "basic" (推奨), "strict" から選択可能
    "python.analysis.typeCheckingMode": "basic",

    // 3. 旧来のリント機能を無効化（重複警告の防止）
    // 既に black, flake8, autopep8 拡張等を入れている場合は無効化またはアンインストール
    "python.formatting.provider": "none"

}
